# Normalize text files in the repository to LF.
* text=auto eol=lf

# Preserve native Windows line endings for Windows scripts.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.psd1 text eol=crlf
*.psm1 text eol=crlf

# Improve diffs for common Laravel source formats.
*.blade.php diff=html
*.css       diff=css
*.html      diff=html
*.md        diff=markdown
*.php       diff=php

# Keep common binary formats out of line-ending conversion.
*.7z   binary
*.avi  binary
*.doc  binary
*.docx binary
*.eot  binary
*.gif  binary
*.gz   binary
*.ico  binary
*.jpeg binary
*.jpg  binary
*.mov  binary
*.mp3  binary
*.mp4  binary
*.otf  binary
*.pdf  binary
*.png  binary
*.tar  binary
*.ttf  binary
*.webm binary
*.webp binary
*.woff binary
*.woff2 binary
*.xls  binary
*.xlsx binary
*.zip  binary

# Exclude repository-only metadata from release archives.
/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
